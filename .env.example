# コピーして .env を作成(.env は Git 管理外)。値はここに書かず、各サービスの管理画面/CLI から設定する。
DATABASE_URL=
SESSION_SECRET=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=
FRONTEND_URL=
# カンマ区切り。未設定なら https://quiz.astro-root.com と http://localhost:5173
ALLOWED_ORIGINS=
# lax | strict | none(未設定: 本番 none / 開発 lax)。フロントと API が同一オリジンなら lax を推奨
COOKIE_SAMESITE=
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
