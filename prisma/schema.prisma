generator client {
  provider = "prisma-client-js"
}
datasource db {
  provider = "postgresql"
}

model User {
  id           String    @id @default(cuid())
  googleId     String?   @unique
  username     String?   @unique  // @から始まるユニークID
  name         String
  bio          String?
  rate         Int       @default(0)
  titleId      String?
  email        String?   @unique
  avatarUrl    String?
  isAdmin      Boolean   @default(false)
  createdAt    DateTime  @default(now())
  passwordAuth PasswordAuth?
  questionSets QuestionSet[]
  battleRecords BattleRecord[]
  following        Follow[]        @relation("follower")
  followers        Follow[]        @relation("following")
  sentMessages     DirectMessage[] @relation("dmFrom")
  receivedMessages DirectMessage[] @relation("dmTo")
  notifications    Notification[]
  questionHistories QuestionHistory[]
  questionReports   QuestionReport[]
}

model PasswordAuth {
  id           String   @id @default(cuid())
  userId       String   @unique
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  passwordHash String
  createdAt    DateTime @default(now())
}

model PasswordReset {
  id        String   @id @default(cuid())
  userId    String
  token     String   @unique
  expiresAt DateTime
  createdAt DateTime @default(now())
}

model Question {
  id            Int      @id @default(autoincrement())
  text          String
  answer        String
  answers       String[]
  displayAnswer String
  authorId      String?
  genre         String   @default("ノンジャンル")
  approved      Boolean  @default(true)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

model QuestionSet {
  id          String        @id @default(cuid())
  userId      String
  user        User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  name        String
  description String?
  isPublic    Boolean       @default(false)
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt
  items       QuestionSetItem[]
}

model QuestionSetItem {
  id            Int         @id @default(autoincrement())
  setId         String
  set           QuestionSet @relation(fields: [setId], references: [id], onDelete: Cascade)
  text          String
  answer        String
  answers       String[]
  displayAnswer String
  genre         String   @default("ノンジャンル")
  order         Int         @default(0)
}

model BattleRecord {
  id         String   @id @default(cuid())
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  roomId     String
  ruleId     String
  result     String   // WIN / LOSE / ACTIVE
  correct    Int      @default(0)
  wrong      Int      @default(0)
  score      Int      @default(0)
  playerCount   Int     @default(0)
  isMatchmaking Boolean @default(false)
  playedAt      DateTime @default(now())
}

model Announcement {
  id        Int      @id @default(autoincrement())
  title     String
  body      String
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
}

model Contact {
  id        String   @id @default(cuid())
  userId    String?
  email     String
  category  String
  body      String
  status    String   @default("open")
  createdAt DateTime @default(now())
}

model Follow {
  id          String   @id @default(cuid())
  followerId  String
  followingId String
  createdAt   DateTime @default(now())
  follower    User     @relation("follower",  fields: [followerId],  references: [id], onDelete: Cascade)
  following   User     @relation("following", fields: [followingId], references: [id], onDelete: Cascade)

  @@unique([followerId, followingId])
}

model DirectMessage {
  id        String   @id @default(cuid())
  fromId    String
  toId      String
  body      String
  read      Boolean  @default(false)
  createdAt DateTime @default(now())
  from      User     @relation("dmFrom", fields: [fromId], references: [id], onDelete: Cascade)
  to        User     @relation("dmTo",   fields: [toId],   references: [id], onDelete: Cascade)
}

model Notification {
  id        String   @id @default(cuid())
  userId    String
  type      String
  fromId    String?
  data      String?
  read      Boolean  @default(false)
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model QuestionHistory {
  id         String   @id @default(cuid())
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  text       String
  answer     String
  userAnswer String
  isCorrect  Boolean
  genre      String   @default("ノンジャンル")
  questionId Int?
  playedAt   DateTime @default(now())
}

model QuestionReport {
  id         String   @id @default(cuid())
  userId     String
  questionId Int
  reason     String
  createdAt  DateTime @default(now())
  resolved   Boolean  @default(false)
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model session {
  sid    String   @id @db.VarChar
  sess   Json
  expire DateTime @db.Timestamp(6)

  @@index([expire], name: "IDX_session_expire")
}
