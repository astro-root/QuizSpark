diff --git a/src/styles/pages.css b/src/styles/pages.css
new file mode 100644
index 0000000..481cdf5
--- /dev/null
+++ b/src/styles/pages.css
@@ -0,0 +1,107 @@
+/* ページ固有のスタイル: ホーム(qh)・ログイン(qa)・マイページ(qp)・ランキング(qr) */
+
+/* ===== ホーム ===== */
+.qh { max-width: 1040px; margin: 0 auto; padding: var(--sp-4); display: grid; gap: var(--sp-4); grid-template-columns: minmax(0, 1fr); }
+.qh__main { display: flex; flex-direction: column; gap: var(--sp-4); min-width: 0; }
+.qh__hud { order: -1; }
+.qh__greet { font-size: var(--fs-2xl); font-weight: 800; }
+.qh__greet small { display: block; margin-top: 2px; color: var(--muted); font-size: var(--fs-md); font-weight: 400; }
+.qh__cards { display: grid; gap: var(--sp-3); grid-template-columns: minmax(0, 1fr); }
+
+.qh-card { position: relative; display: flex; align-items: center; gap: var(--sp-4); width: 100%; min-height: 96px; padding: var(--sp-5) var(--sp-6); border-radius: var(--r-xl); color: #fff; text-align: left; overflow: hidden; }
+.qh-card::after { content: ''; position: absolute; top: -40px; right: -30px; width: 140px; height: 140px; border-radius: 50%; background: rgba(255,255,255,.07); }
+.qh-card--random { background: linear-gradient(135deg, #4c1d95, #7c3aed 55%, #a855f7); box-shadow: 0 8px 32px rgba(124,58,237,.4); }
+.qh-card--free   { background: linear-gradient(135deg, #064e3b, #0f766e 55%, #14b8a6); box-shadow: 0 8px 32px rgba(20,184,166,.28); }
+.qh-card__icon { display: grid; place-items: center; flex: none; width: 52px; height: 52px; border-radius: var(--r-lg); background: rgba(255,255,255,.16); position: relative; z-index: 1; }
+.qh-card__text { flex: 1; min-width: 0; position: relative; z-index: 1; }
+.qh-card__text b { display: block; font-size: var(--fs-lg); font-weight: 900; letter-spacing: .5px; }
+.qh-card__text small { display: block; margin-top: 3px; font-size: var(--fs-sm); color: rgba(255,255,255,.78); }
+.qh-card > .qs-icon:last-child { opacity: .6; position: relative; z-index: 1; }
+.qh-card:hover { filter: brightness(1.06); }
+
+.qh-me { display: flex; flex-direction: column; gap: var(--sp-4); padding: var(--sp-4); border-radius: var(--r-xl); background: linear-gradient(160deg, var(--accent-soft), var(--surface) 62%); border: 1px solid var(--border); }
+.qh-me__top { display: flex; align-items: center; gap: var(--sp-3); }
+.qh-me__name { font-weight: 900; font-size: var(--fs-lg); overflow-wrap: anywhere; }
+.qh-me__chips { display: flex; flex-wrap: wrap; gap: 6px; margin-top: 4px; }
+.qh-me__rate { margin-left: auto; text-align: right; }
+.qh-me__rate small { display: block; font-size: 11px; font-weight: 700; letter-spacing: 1px; color: var(--muted); }
+.qh-me__rate b { font-family: Orbitron, sans-serif; font-size: 28px; font-weight: 900; color: var(--accent3); line-height: 1.1; }
+.qh-stats { display: grid; grid-template-columns: repeat(3, 1fr); gap: var(--sp-2); }
+.qh-stat { padding: var(--sp-2) var(--sp-1); border-radius: var(--r-md); background: var(--surface2); text-align: center; }
+.qh-stat b { display: block; font-size: var(--fs-lg); font-weight: 900; }
+.qh-stat small { font-size: 11px; color: var(--muted); font-weight: 700; }
+
+.qh-news { display: flex; flex-direction: column; gap: var(--sp-2); }
+.qh-news h2 { display: flex; align-items: center; gap: 6px; font-size: 12px; font-weight: 700; color: var(--muted); letter-spacing: 1px; }
+.qh-news__item { padding: var(--sp-3) var(--sp-4); border-radius: var(--r-md); background: var(--accent-soft); border: 1px solid var(--border); }
+.qh-news__item b { display: block; font-size: var(--fs-sm); color: var(--accent3); margin-bottom: 2px; }
+.qh-news__item p { font-size: var(--fs-sm); color: var(--sub); overflow-wrap: anywhere; }
+
+@media (min-width: 768px) {
+  .qh__cards { grid-template-columns: repeat(2, minmax(0, 1fr)); }
+  .qh-card { flex-direction: column; align-items: flex-start; min-height: 180px; }
+  .qh-card > .qs-icon:last-child { position: absolute; right: var(--sp-5); bottom: var(--sp-5); }
+}
+@media (min-width: 1024px) {
+  .qh { grid-template-columns: minmax(0, 1fr) 340px; padding: var(--sp-8) var(--sp-8) var(--sp-10); gap: var(--sp-6); align-items: start; }
+  .qh__hud { order: 2; position: sticky; top: calc(var(--nav-top-h) + var(--sp-6)); }
+}
+
+/* ===== ログイン / 新規登録 ===== */
+.qa { position: fixed; inset: 0; z-index: 1000; display: grid; place-items: center; padding: var(--sp-5); background: rgba(0,0,0,.75); overflow-y: auto; }
+.qa__box { width: 100%; max-width: 400px; margin: auto; padding: 28px 24px; border-radius: var(--r-xl); background: var(--surface); border: 1px solid var(--border); }
+.qa__box h2 { font-size: var(--fs-lg); font-weight: 900; margin-bottom: 4px; }
+.qa__sub { font-size: var(--fs-xs); color: var(--muted); margin-bottom: var(--sp-5); }
+.qa__tabs { display: flex; gap: 4px; padding: 4px; margin-bottom: var(--sp-5); border-radius: var(--r-md); background: var(--surface2); }
+.qa__tabs button { flex: 1; min-height: 40px; border-radius: var(--r-sm); font-size: var(--fs-md); font-weight: 700; background: transparent; color: var(--muted); }
+.qa__tabs button[aria-selected="true"] { background: var(--accent); color: #fff; }
+.qa__field { display: block; margin-bottom: var(--sp-4); }
+.qa__field > span { display: block; margin-bottom: 8px; font-size: 12px; font-weight: 700; color: var(--sub); }
+.qa__field em { margin-left: 6px; color: var(--wrong); font-style: normal; }
+.qa__input { width: 100%; min-height: 48px; padding: 0 16px; background: var(--surface2); border: 1.5px solid var(--border); border-radius: var(--r-md); font-size: 16px; color: var(--text); }
+.qa__input:focus { border-color: var(--accent); }
+.qa__at { position: relative; }
+.qa__at::before { content: '@'; position: absolute; left: 14px; top: 50%; transform: translateY(-50%); color: var(--muted); }
+.qa__at .qa__input { padding-left: 30px; }
+.qa__hint { margin-top: 6px; font-size: 12px; color: var(--muted); }
+.qa__error { margin-bottom: var(--sp-3); padding: 8px 12px; border-radius: var(--r-sm); background: var(--lose-soft); color: var(--wrong); font-size: var(--fs-sm); }
+.qa__actions { display: flex; flex-direction: column; gap: var(--sp-2); }
+
+/* ===== マイページ(枠) ===== */
+.qp-head { background: var(--surface); border-bottom: 1px solid var(--border); }
+.qp-head__in { display: flex; align-items: center; gap: var(--sp-4); max-width: var(--w); margin: 0 auto; padding: var(--sp-4); }
+.qp-head__name { font-weight: 900; font-size: var(--fs-lg); overflow-wrap: anywhere; }
+.qp-head__sub { font-size: var(--fs-xs); color: var(--muted); margin-top: 2px; overflow-wrap: anywhere; }
+.qp-head__rate { margin-left: auto; text-align: right; flex: none; }
+.qp-head__rate small { display: block; font-size: 11px; color: var(--muted); font-weight: 700; letter-spacing: 1px; }
+.qp-head__rate b { font-family: Orbitron, sans-serif; font-size: 24px; font-weight: 900; color: var(--accent3); }
+.qp-tabs { background: var(--surface); border-bottom: 1px solid var(--border); }
+.qp-tabs__in { display: flex; max-width: var(--w); margin: 0 auto; overflow-x: auto; }
+.qp-tab { flex: 1 0 auto; min-width: 64px; display: flex; flex-direction: column; align-items: center; gap: 4px; padding: var(--sp-3) var(--sp-3); font-size: 11px; font-weight: 700; color: var(--muted); background: none; border-bottom: 2px solid transparent; border-radius: 0; }
+.qp-tab[aria-selected="true"] { color: var(--accent3); border-bottom-color: var(--accent); }
+@media (min-width: 768px) { .qp-tab { flex-direction: row; justify-content: center; gap: 8px; font-size: var(--fs-sm); } }
+
+/* ===== ランキング ===== */
+.qr { max-width: 760px; margin: 0 auto; padding: var(--sp-4); display: flex; flex-direction: column; gap: var(--sp-4); }
+.qr h1 { font-size: var(--fs-xl); font-weight: 800; }
+.qr-me { display: flex; align-items: center; gap: var(--sp-4); padding: var(--sp-4) var(--sp-5); border-radius: var(--r-lg); color: #fff; background: linear-gradient(135deg, var(--accent), var(--accent2)); }
+.qr-me__rank { width: 48px; text-align: center; font-family: Orbitron, sans-serif; font-size: 28px; font-weight: 900; }
+.qr-me b { display: block; font-size: var(--fs-lg); font-weight: 900; }
+.qr-me small { display: block; margin-top: 2px; font-size: var(--fs-sm); color: rgba(255,255,255,.8); }
+.qr-bands { display: flex; flex-wrap: wrap; gap: 6px; list-style: none; }
+.qr-band { display: inline-flex; align-items: center; gap: 6px; padding: 4px 12px; border-radius: var(--r-full); background: var(--surface); border: 1px solid var(--border); font-size: 12px; color: var(--sub); }
+.qr-list { display: flex; flex-direction: column; gap: 6px; list-style: none; }
+.qr-row { display: flex; align-items: center; gap: var(--sp-3); width: 100%; min-height: 64px; padding: var(--sp-3) var(--sp-4); text-align: left; border-radius: var(--r-md); background: var(--surface); border: 1px solid var(--border); color: var(--text); }
+.qr-row:hover { border-color: var(--accent); }
+.qr-row--me { background: var(--accent-soft); border-color: var(--accent); }
+.qr-row__rank { flex: none; width: 32px; display: grid; place-items: center; font-family: Orbitron, sans-serif; font-weight: 900; font-size: 14px; color: var(--muted); }
+.qr-row__main { flex: 1; min-width: 0; }
+.qr-row__name { display: flex; align-items: center; gap: 6px; }
+.qr-row__name b { font-size: 14px; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
+.qr-row--me .qr-row__name b { font-weight: 800; }
+.qr-row__sub { margin-top: 2px; font-size: 11px; color: var(--muted); }
+.qr-row__rate { flex: none; text-align: right; font-family: Orbitron, sans-serif; font-size: 16px; font-weight: 900; color: var(--accent3); }
+.qr-row__rate small { display: block; font-size: 10px; color: var(--muted); font-weight: 400; }
+.qr-tier { display: inline-flex; align-items: center; gap: 4px; flex: none; padding: 1px 8px; border-radius: var(--r-full); font-size: 11px; font-weight: 700; color: var(--tier, var(--sub)); background: color-mix(in srgb, var(--tier, #888) 14%, transparent); }
+.qr-empty { padding: var(--sp-10); text-align: center; color: var(--muted); }
+@media (min-width: 1024px) { .qr { padding: var(--sp-8); } }
diff --git a/tests/pages.test.ts b/tests/pages.test.ts
new file mode 100644
index 0000000..c6f7d04
--- /dev/null
+++ b/tests/pages.test.ts
@@ -0,0 +1,51 @@
+import { test } from 'node:test'
+import assert from 'node:assert/strict'
+import fs from 'node:fs'
+import path from 'node:path'
+import { RANK_BANDS, bandForRate, bandForLabel, bandRange } from '../src/lib/rank'
+import { ICONS } from '../src/components/ui/iconPaths'
+
+const SRC = path.resolve(__dirname, '../src')
+const read = (f: string) => fs.readFileSync(path.join(SRC, f), 'utf8')
+const EMOJI = /[\u{1F300}-\u{1FAFF}\u{1F000}-\u{1F2FF}\u2600-\u27BF\u2B50\u23E9-\u23FF\u231A\u231B\u2190-\u2199\u25AA-\u25FE\u2139\u2122]/gu
+
+test('ランク帯: 基準値・名称がサーバー(getRankLabel)の定義と一致する', () => {
+  const server = fs.readFileSync(path.resolve(__dirname, '../server/routes/ranking.ts'), 'utf8')
+  const found = [...server.matchAll(/rate >=\s*(\d+)\)\s*return\s*\{\s*label:\s*'([^']+)'/g)].map(m => ({ min: Number(m[1]), label: m[2] }))
+  assert.equal(found.length, 5)
+  for (const f of found) assert.equal(RANK_BANDS.find(b => b.label === f.label)?.min, f.min, f.label)
+  assert.equal(RANK_BANDS[0].label, 'ブロンズ') // 最下位は条件なしで返る
+  assert.equal(RANK_BANDS[0].min, 0)
+})
+test('ランク帯: 隙間・重複がなく、境界値が正しい帯に入る', () => {
+  for (let i = 0; i < RANK_BANDS.length - 1; i++) assert.equal(RANK_BANDS[i].max! + 1, RANK_BANDS[i + 1].min)
+  assert.equal(RANK_BANDS.at(-1)!.max, null)
+  const cases: Array<[number, string]> = [[0, 'ブロンズ'], [599, 'ブロンズ'], [600, 'シルバー'], [899, 'シルバー'], [900, 'ゴールド'], [1199, 'ゴールド'], [1200, 'プラチナ'], [1499, 'プラチナ'], [1500, 'ダイヤ'], [1999, 'ダイヤ'], [2000, 'マスター'], [5000, 'マスター'], [-5, 'ブロンズ']]
+  for (const [rate, label] of cases) assert.equal(bandForRate(rate).label, label, String(rate))
+  assert.equal(bandForLabel('存在しない').label, 'ブロンズ')
+  assert.equal(bandRange(RANK_BANDS[5]), '2000〜')
+  for (const b of RANK_BANDS) assert.ok(b.icon in ICONS)
+})
+
+test('回帰ガード: useAuth() から存在しない authLoading を読んでいない(常に undefined になるバグ)', () => {
+  const offenders: string[] = []
+  const walk = (d: string) => { for (const e of fs.readdirSync(d, { withFileTypes: true })) { const p = path.join(d, e.name); if (e.isDirectory()) walk(p); else if (/\.tsx?$/.test(e.name)) {
+    const s = fs.readFileSync(p, 'utf8')
+    for (const m of s.matchAll(/const \{([^}]*)\}\s*=\s*useAuth\(\)/g)) if (/\bauthLoading\b/.test(m[1]) && !/loading:\s*authLoading/.test(m[1])) offenders.push(path.relative(SRC, p))
+  } } }
+  walk(SRC)
+  assert.deepEqual(offenders, [])
+  assert.match(read('context/AuthContext.tsx'), /loading: boolean/)
+})
+
+test('ホーム・ランキング・マイページ枠は絵文字を使わず、ログインは role=dialog・ラベル付き', () => {
+  for (const f of ['pages/HomePage.tsx', 'pages/RankingPage.tsx', 'pages/ProfilePage.tsx', 'lib/rank.ts'])
+    assert.equal([...read(f).matchAll(EMOJI)].length, 0, f)
+  const home = read('pages/HomePage.tsx')
+  assert.match(home, /role="dialog" aria-modal="true"/)
+  assert.match(home, /autoComplete=\{authTab === 'login' \? 'current-password' : 'new-password'\}/)
+  assert.match(home, /role="alert"/)
+})
+test('ランキングの行は、キーボードで操作できる button である', () => {
+  assert.match(read('pages/RankingPage.tsx'), /<button className=\{`qr-row/)
+})
