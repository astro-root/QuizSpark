generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model Question {
  id            Int      @id @default(autoincrement())
  text          String
  answer        String
  answers       String[]
  displayAnswer String
  authorId      String?
  approved      Boolean  @default(true)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}
