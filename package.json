    "cloudinary": "^1.41.3",
    "connect-pg-simple": "^10.0.0",
    "cors": "^2.8.6",
    "csv-parse": "^6.2.1",
    "dotenv": "^17.4.2",
    "express": "^4.18.3",
    "express-rate-limit": "^8.5.1",
    "express-session": "^1.19.0",
    "lucide-react": "^1.14.0",
    "multer": "^2.1.1",
    "multer-storage-cloudinary": "^4.0.0",
    "nodemailer": "^8.0.7",
    "passport": "^0.7.0",
    "passport-google-oauth20": "^2.0.0",
    "passport-local": "^1.0.0",
    "pg": "^8.16.0",
    "prisma": "^7.8.0",
    "react": "^18.3.1",
